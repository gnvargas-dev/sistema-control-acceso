class Rol {
  <<abstract>>
  +clave()* RolUsuario
  +rutaInicio()* string
  +menu()* array
  +perfilDe(Usuario usuario)* ?Persona
  +veListadoDeAlumnos()* bool
  +veAlumnosDeMateria(Usuario usuario, Materia materia)* bool
  +veAlumno(Usuario usuario, Alumno alumno)* bool
  +cargaDatosDeMateria(Usuario usuario, int|string|null materiaId)* bool
  +esTitularDelRegistro(Usuario usuario, int|string|null alumnoId)* bool
  +reglasDeRegistro()* array
  +crearPerfil(int usuarioId, array datos, Collection materiaIds)* void
  +nombre() string
  +esUnoDe(string ...claves) bool
  +desde(RolUsuario|string rol)$ self
  +tryDesde(RolUsuario|string rol)$ ?self
  -instanciar(RolUsuario clave)$ self
}

