class ItemMenu {
  <<final readonly>>
  +string ruta
  +string titulo
  +string icono
  +string? subtitulo
  +__construct(ruta, titulo, icono, subtitulo)
}

class RolUsuario {
  <<enumeration>>
  Administrador = 'administrador'
  Profesor = 'profesor'
  Alumno = 'alumno'
  +etiqueta() string
}

class Usuario

Rol <|-- RolAdministrador
Rol <|-- RolProfesor
Rol <|-- RolAlumno

Rol ..> RolAdministrador : crea
Rol ..> RolProfesor : crea
Rol ..> RolAlumno : crea
Rol ..> RolUsuario
RolAdministrador ..> ItemMenu : crea
RolProfesor ..> ItemMenu : crea
RolAlumno ..> ItemMenu : crea
Usuario ..> Rol : rolObjeto()

note for Usuario "Usuario se define en D1a. Tiene una sola columna rol,<br/>pero rolObjeto() crea un objeto Rol nuevo en cada llamada."
